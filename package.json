{
  "name": "civil-ontology-dsh",
  "version": "1.0.1",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "description": "民事法律关系本体、固定交互式关系图、会话回流与逐项审阅的证据画布。",
  "keywords": ["民事法律关系", "合同审查", "法律咨询", "类案检索", "本体", "法律"],
  "engines": {
    "node": ">=24.14.1"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "*.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "civil/*.json",
    "weekly-ui/**",
    "ontology-ui/**",
    "canvas-lock.json",
    "skills/*/SKILL.md",
    "word/**",
    "README.md",
    "使用说明.md"
  ],
  "scripts": {
    "test": "node --test"
  }
}
